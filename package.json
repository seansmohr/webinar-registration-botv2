{
  "name": "webinar-registration-bot",
  "version": "1.0.0",
  "description": "Voice agent system for Mohr Insurance Services - Medicare webinar outreach",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "nodemon server/index.js",
    "dev:client": "cd client && npm run dev",
    "start": "node server/index.js",
    "build": "cd client && npm run build",
    "db:migrate": "node server/db/migrate.js"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "luxon": "^3.4.4",
    "node-cron": "^3.0.3",
    "pg": "^8.12.0",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "nodemon": "^3.0.2"
  }
}
